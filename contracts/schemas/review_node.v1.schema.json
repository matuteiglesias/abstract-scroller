{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review_node.v1",
  "type": "object",
  "required": ["version", "node_id", "title"],
  "properties": {
    "version": {"type": "string", "const": "review_node.v1"},
    "node_id": {"type": "string", "minLength": 1},
    "doc_id": {"type": "string"},
    "title": {"type": "string"},
    "abstract": {"type": "string"},
    "date": {"type": "string"},
    "year": {"type": ["integer", "string"]},
    "venue": {"type": "string"},
    "has_code": {"type": ["boolean", "integer", "string"]},
    "doi": {"type": "string"},
    "arxiv_id": {"type": "string"},
    "repec_id": {"type": "string"},
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
